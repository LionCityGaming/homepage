# Copy to .env next to your compose file and fill in what you use.
# Homepage reads every HOMEPAGE_VAR_* variable and swaps {{HOMEPAGE_VAR_*}} in the YAML for it.
# Widgets whose variables you leave empty just show an error; delete the ones you don't run.

# Your domain, e.g. example.com (services are linked as https://<app>.<domain>)
HOMEPAGE_VAR_DOMAIN=
# The host running most of the containers, e.g. 192.168.1.10
HOMEPAGE_VAR_DOCKER_HOST=

# Audiobookshelf
HOMEPAGE_VAR_AUDIOBOOKSHELF_API_KEY=
HOMEPAGE_VAR_AUDIOBOOKSHELF_URL=

# Authentik
HOMEPAGE_VAR_AUTHENTIK_API_KEY=

# Bazarr
HOMEPAGE_VAR_BAZARR_API_KEY=
HOMEPAGE_VAR_BAZARR_URL=

# Booklore
HOMEPAGE_VAR_BOOKLORE_PASSWORD=
HOMEPAGE_VAR_BOOKLORE_USERNAME=

# Caddy
HOMEPAGE_VAR_CADDY_URL=

# Calendar
